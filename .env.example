# Copy to .env for local use; set values in a secret manager in deployment.
# Leave unused optional integrations unset. Never commit a populated .env.
#
# Required for API and database tooling; provisioned/injected by Replit's database
# integration on Replit. Replace with your own PostgreSQL connection URL elsewhere.
DATABASE_URL=
#
# Required for each Vite artifact build (portal and mockup); Replit supplies the
# artifact mount path. Set the deployment mount path when hosting elsewhere.
BASE_PATH=
#
# Replit-injected runtime identity and port. Replace REPL_ID/OIDC integration and
# supply PORT via the host when deploying outside Replit.
REPL_ID=
PORT=
#
# Optional OIDC issuer override; default is Replit OIDC. Replace the Replit
# authentication integration/issuer for independent deployments.
ISSUER_URL=
#
# Optional object storage paths, supplied by Replit object storage integration.
# Replace the Replit sidecar/storage integration for independent deployments.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
#
# Optional email delivery; configure for invitations and notifications.
# Replace the Resend provider/integration if using another email service.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=
#
# Optional access policies; configure explicitly before production use.
# Source currently has fallback admin/internal domains when these are unset.
ADMIN_EMAILS=
ADMIN_DOMAINS=
INTERNAL_EMAIL_DOMAINS=
#
# Optional Google Sheets integration. VITE_ values are PUBLIC client-side
# build variables; never put secrets there. Replace Apps Script in other hosting.
GOOGLE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_URL=
#
# Optional portal origin for links in reminder emails.
PORTAL_URL=
#
# Optional runtime/build settings. NODE_ENV and PORT are normally host-injected.
NODE_ENV=
LOG_LEVEL=
PUPPETEER_EXECUTABLE_PATH=
#
# Optional test-only switches; do not enable against production data.
RUN_CONSENT_ISOLATION_TESTS=
RUN_PROVIDER_ISOLATION_TESTS=
#
# Vite's import.meta.env.BASE_URL is generated from the build base config;
# it is not a separate secret or an environment variable to set here.